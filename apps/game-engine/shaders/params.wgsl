// params.wgsl — значения, которые процессор присылает на GPU один раз за кадр.
// Подключается в scene.wgsl директивой "//#include params.wgsl" (см. js/gfx/shaders.js).
//
// Порядок полей обязан совпадать с раскладкой Float32Array(52) на стороне JS:
// единственное место, где он задан, — js/scene/pack.js → GE.writeFrame().
//
// Смещения (байты):
//   resolution   0    размер кадра в пикселях
//   fov          8    вертикальный угол обзора, радианы
//   time         12   игровое время, секунды
//   camPos       16   .xyz позиция камеры
//   camForward   32   .xyz направление взгляда
//   camRight     48   .xyz вправо
//   camUp        64   .xyz вверх
//   sunDir       80   .xyz направление НА солнце (единичное)
//   sunColor     96   .rgb цвет солнца, .w сила (0 — солнце под горизонтом)
//   skyAmbient   112  .rgb цвет скайбокс-света (день/ночь, считает процессор)
//   counts       128  .x сферы, .y конусы, .z кубы (u32)
//   extra        144  .x яркость, .y тени (0/1), .z звёзды (0/1), .w разметка земли (0/1)
//   frame        160  .x tan(угол обзора / 2), .y день 0…1, .z солнце над горизонтом 0…1,
//                     .w закатная полоса 0…1
//   frame2       176  .x «день для поверхности» 0…1, .yzw цвет солнца, уже умноженный на силу
//   mask         192  .x сторона решётки (1 — обычный кадр), .y номер прохода
//
// Размер структуры: 208 байт.
//
// Зачем frame и frame2: всё это зависит только от солнца и камеры — то есть одно на весь
// кадр. Считать это в каждом пикселе (четыре smoothstep, tan, умножение цвета солнца)
// на слабых GPU стоит заметную долю кадра: 0.3 мегапикселя — это 300 тысяч повторов.

struct Params {
  resolution : vec2f,
  fov        : f32,
  time       : f32,
  camPos     : vec4f,
  camForward : vec4f,
  camRight   : vec4f,
  camUp      : vec4f,
  sunDir     : vec4f,
  sunColor   : vec4f,
  skyAmbient : vec4f,
  counts     : vec4u,
  extra      : vec4f,
  frame      : vec4f,
  frame2     : vec4f,
  mask       : vec4f,
};
